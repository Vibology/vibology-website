{{!-- Site Footer --}}
<footer class="site-footer">
    <div class="container">
        {{!-- Mobile-only Newsletter and Social --}}
        <div class="footer-mobile-content">
            <div class="footer-section footer-newsletter">
                <p class="footer-newsletter-text">Get the latest posts delivered straight to your inbox.</p>

                {{#if @site.members_enabled}}
                <form class="footer-subscribe-form" data-members-form>
                    <input
                        class="footer-subscribe-input"
                        type="email"
                        name="email"
                        placeholder="Your email address"
                        required
                        aria-label="Email address"
                    >
                    <button class="footer-subscribe-button" type="submit">Subscribe</button>
                </form>
                {{/if}}

                {{!-- Follow Us --}}
                <div class="footer-follow">
                    <h4 class="footer-follow-title">Follow Vibology</h4>
                    <div class="footer-social-links">
                        {{#if @site.twitter}}
                        <a href="{{@site.twitter}}" class="footer-social-link" target="_blank" rel="noopener" aria-label="X">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                            </svg>
                        </a>
                        {{/if}}
                        {{#if @site.facebook}}
                        <a href="{{@site.facebook}}" class="footer-social-link" target="_blank" rel="noopener" aria-label="Facebook">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                            </svg>
                        </a>
                        {{/if}}
                        {{#if @custom.bluesky_url}}
                        <a href="{{@custom.bluesky_url}}" class="footer-social-link" target="_blank" rel="noopener" aria-label="Bluesky">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"/>
                            </svg>
                        </a>
                        {{/if}}
                        {{#if @custom.youtube_url}}
                        <a href="{{@custom.youtube_url}}" class="footer-social-link" target="_blank" rel="noopener" aria-label="YouTube">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                            </svg>
                        </a>
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>

        {{!-- Footer Legal Bar --}}
        <div class="footer-bottom">
            <p class="footer-legal">
                <span class="footer-legal-line">
                    <a href="/privacy-policy/">Privacy Policy</a>
                    <span class="footer-separator">|</span>
                    <a href="/terms-of-service/">Terms of Service</a>
                </span>
                <span class="footer-legal-line">
                    &copy; {{date format="YYYY"}} {{@site.title}}
                    <span class="footer-separator">|</span>
                    Powered by <a href="https://ghost.org" target="_blank" rel="noopener">Ghost</a>
                </span>
            </p>
        </div>
    </div>
</footer>
