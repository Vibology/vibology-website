{{!-- Default Post Card (Vertical) --}}
<article class="post-card {{post_class}}">
    {{#if feature_image}}
    <a href="{{url}}" class="post-card-image-link">
        <img
            srcset="{{img_url feature_image size="s"}} 400w,
                    {{img_url feature_image size="m"}} 750w,
                    {{img_url feature_image size="l"}} 1200w"
            sizes="(max-width: 768px) 400px, (max-width: 1024px) 750px, 1200px"
            src="{{img_url feature_image size="m"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            class="post-card-image"
            loading="lazy"
        >
    </a>
    {{/if}}

    <div class="post-card-content">
        <h2 class="post-card-title">
            <a href="{{url}}">{{title}}</a>
        </h2>

        {{#if excerpt}}
        <p class="post-card-excerpt">
            {{excerpt words="20"}}
        </p>
        {{/if}}

        <div class="post-card-meta-wrapper">
            <div class="post-card-meta-dates">
                <span class="meta-item">
                    {{> "icons/calendar"}}
                    <time datetime="{{date format="YYYY-MM-DD"}}">
                        {{date format="MMM DD, YYYY"}}
                    </time>
                </span>
                {{#if reading_time}}
                <span class="post-card-separator">•</span>
                <span class="meta-item">
                    {{> "icons/clock"}}
                    <span class="reading-time">{{reading_time}}</span>
                </span>
                {{/if}}
            </div>

            {{#primary_author}}
            <div class="post-card-author">
                {{#if profile_image}}
                <img
                    src="{{img_url profile_image size="xs"}}"
                    alt="{{name}}"
                    class="author-avatar-small"
                    style="width: 20px; height: 20px; object-fit: cover;"
                    loading="lazy"
                >
                {{/if}}
                <span class="author-name">{{name}}</span>
            </div>
            {{/primary_author}}
        </div>

        {{#primary_tag}}<a href="{{url}}" class="tag">{{name}}</a>{{/primary_tag}}
    </div>
</article>
