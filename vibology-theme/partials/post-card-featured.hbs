{{!-- Featured Post Card (Large Hero) --}}
<article class="post-card post-card-featured {{post_class}}">
    {{#if feature_image}}
    <a href="{{url}}" class="post-card-image-link">
        <img
            srcset="{{img_url feature_image size="m"}} 750w,
                    {{img_url feature_image size="l"}} 1200w,
                    {{img_url feature_image size="xl"}} 2000w"
            sizes="(max-width: 1024px) 750px, (max-width: 1280px) 1200px, 2000px"
            src="{{img_url feature_image size="l"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            class="post-card-image"
            loading="eager"
        >
    </a>
    {{/if}}

    <div class="post-card-content">
        {{#primary_tag}}<a href="{{url}}" class="tag">{{name}}</a>{{/primary_tag}}

        <h2 class="post-card-title">
            <a href="{{url}}">{{title}}</a>
        </h2>

        {{#if custom_excerpt}}
        <p class="post-card-excerpt">
            {{custom_excerpt}}
        </p>
        {{else}}{{#if excerpt}}
        <p class="post-card-excerpt">
            {{excerpt words="40"}}
        </p>
        {{/if}}{{/if}}

        <div class="post-card-meta">
            {{#primary_author}}
            <div class="post-card-author">
                {{#if profile_image}}
                <img src="{{img_url profile_image size="xs"}}" alt="{{name}}" class="author-avatar-small">
                {{/if}}
                <span class="author-name">{{name}}</span>
            </div>
            {{/primary_author}}

            <div class="post-card-meta-info">
                <time datetime="{{date format="YYYY-MM-DD"}}">
                    {{date format="MMM DD, YYYY"}}
                </time>
                {{#if reading_time}}
                <span class="reading-time">{{reading_time}}</span>
                {{/if}}
            </div>
        </div>
    </div>
</article>
