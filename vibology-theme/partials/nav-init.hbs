{{!-- Navigation Initialization - Build HTML with Handlebars, not JavaScript --}}
<script>
(function() {
  'use strict';

  // Store pre-built navigation HTML (built server-side by Handlebars)
  var desktopNav = '';
  var mobileNav = '';
  var dropdowns = {};

  // Process secondary navigation for dropdowns
  {{#foreach @site.secondary_navigation}}
  (function() {
    var label = '{{label}}';
    var url = '{{{url}}}';
    var current = {{#if current}}true{{else}}false{{/if}};

    if (label.indexOf('|') !== -1) {
      var parts = label.split('|');
      var dropdownName = parts[0].replace(/^\s+|\s+$/g, '');
      var itemLabel = parts[1].replace(/^\s+|\s+$/g, '');

      if (!dropdowns[dropdownName]) {
        dropdowns[dropdownName] = [];
      }
      dropdowns[dropdownName].push({
        label: itemLabel,
        url: url,
        current: current
      });
    }
  })();
  {{/foreach}}

  // Build dropdown HTML
  for (var name in dropdowns) {
    if (dropdowns.hasOwnProperty(name)) {
      var items = dropdowns[name];

      desktopNav += '<li class="has-dropdown"><a href="#" role="button" aria-expanded="false" aria-haspopup="true">' + name + '</a><ul class="nav-dropdown" role="menu">';
      for (var i = 0; i < items.length; i++) {
        desktopNav += '<li role="none"><a href="' + items[i].url + '" role="menuitem"' + (items[i].current ? ' class="nav-current"' : '') + '>' + items[i].label + '</a></li>';
      }
      desktopNav += '</ul></li>';

      mobileNav += '<li class="has-dropdown"><a href="#" class="dropdown-toggle" role="button" aria-expanded="false">' + name + '</a><ul class="nav-dropdown">';
      for (var j = 0; j < items.length; j++) {
        mobileNav += '<li><a href="' + items[j].url + '"' + (items[j].current ? ' class="nav-current"' : '') + '>' + items[j].label + '</a></li>';
      }
      mobileNav += '</ul></li>';
    }
  }

  // Add primary navigation items
  {{#foreach @site.navigation}}
  desktopNav += '<li><a href="{{{url}}}"{{#if current}} class="nav-current"{{/if}}>{{label}}</a></li>';
  mobileNav += '<li><a href="{{{url}}}"{{#if current}} class="nav-current"{{/if}}>{{label}}</a></li>';
  {{/foreach}}

  window.__NAV_HTML__ = {
    desktop: desktopNav,
    mobile: mobileNav
  };
})();
</script>
