{{!< default}}

{{!-- Full Width Page Template --}}

{{#page}}
<article class="page-full page-full-width {{post_class}}" style="padding-top: 3rem;">
    {{!-- Page header --}}
    <header class="page-header">
        <div class="container container-md">
            <div class="page-header-content" style="text-align: center; padding-bottom: 3rem;">
                <h1 class="page-title">{{title}}</h1>

                {{#if custom_excerpt}}
                <p class="page-excerpt" style="font-size: 1.25rem; color: var(--color-text-secondary); margin-top: 1.5rem;">
                    {{custom_excerpt}}
                </p>
                {{/if}}
            </div>
        </div>
    </header>

    {{!-- Feature image --}}
    {{#if feature_image}}
    <figure class="page-feature-image-full" style="margin: 0;">
        <img
            src="{{feature_image}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            style="width: 100%; height: auto; display: block;"
        >
        {{#if feature_image_caption}}
        <figcaption class="container container-md" style="text-align: center; font-size: 0.875rem; color: var(--color-text-secondary); margin-top: 1rem;">
            {{feature_image_caption}}
        </figcaption>
        {{/if}}
    </figure>
    {{/if}}

    {{!-- Page content (full width) --}}
    <div class="page-content-full" style="padding: 3rem 0;">
        <div class="container container-xl">
            {{{content}}}
        </div>
    </div>
</article>
{{/page}}
