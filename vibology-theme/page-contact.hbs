{{!< default}}

{{!-- Contact Page Template --}}

{{#page}}
<div class="post-content-wrapper">
    {{!-- Main Contact Content --}}
    <article class="page-full page-contact {{post_class}} content-card">
        <div class="post-article-inner">
            {{!-- Page header --}}
            <header class="page-header" style="margin-bottom: 3rem; text-align: center;">
                <h1 class="page-title">{{title}}</h1>

                {{#if custom_excerpt}}
                <p class="page-excerpt" style="font-size: 1.25rem; color: var(--color-text-secondary); margin-top: 1.5rem;">
                    {{custom_excerpt}}
                </p>
                {{/if}}
            </header>

            {{!-- Page content (intro text from Ghost editor) --}}
            <div class="page-content contact-intro" style="margin-bottom: 3rem;">
                {{{content}}}
            </div>

            {{!-- Contact Form --}}
            <div class="contact-form-wrapper">
                <form
                    class="contact-form"
                    action="https://formspree.io/f/{{@custom.formspree_id}}"
                    method="POST"
                >
                    <div class="form-group">
                        <label for="contact-name" class="form-label">Name</label>
                        <input
                            type="text"
                            id="contact-name"
                            name="name"
                            class="form-input"
                            placeholder="Your name"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="contact-email" class="form-label">Email</label>
                        <input
                            type="email"
                            id="contact-email"
                            name="email"
                            class="form-input"
                            placeholder="your@email.com"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="contact-subject" class="form-label">Subject</label>
                        <input
                            type="text"
                            id="contact-subject"
                            name="subject"
                            class="form-input"
                            placeholder="What is this about?"
                        >
                    </div>

                    <div class="form-group">
                        <label for="contact-message" class="form-label">Message</label>
                        <textarea
                            id="contact-message"
                            name="message"
                            class="form-textarea"
                            rows="6"
                            placeholder="Your message..."
                            required
                        ></textarea>
                    </div>

                    {{!-- Honeypot field for spam protection --}}
                    <input type="text" name="_gotcha" style="display:none">

                    <button type="submit" class="form-submit">
                        Send Message
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </article>

    {{!-- Sidebar --}}
    {{> "sidebar"}}
</div>
{{/page}}
