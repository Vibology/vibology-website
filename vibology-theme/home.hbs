{{!< default}}

{{!-- Homepage Template with Featured Slider --}}

<div class="home-template">
    {{!-- Featured Slider (image card, text on background) --}}
    <div class="featured-slider-wrapper mb-8">
        {{> "featured-slider"}}
    </div>

    {{!-- Divider --}}
    <div class="featured-slider-divider"></div>

    {{!-- Main Content + Sidebar Layout --}}
    <div class="home-content-wrapper">
        {{!-- Main Content --}}
        <main class="home-main-content">
            <section class="latest-posts">
                <div class="post-feed post-feed-vertical">
                    {{#foreach posts}}
                        {{> "post-card"}}
                    {{/foreach}}
                </div>

                {{!-- Pagination --}}
                {{> "pagination"}}
            </section>
        </main>

        {{!-- Sidebar --}}
        {{> "sidebar"}}
    </div>
</div>
