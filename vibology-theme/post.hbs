{{!< default}}

{{!-- Single Post Template --}}

{{#post}}
<div class="post-content-wrapper">
    {{!-- Main Post Content --}}
    <article class="post-full {{post_class}} content-card">
        <div class="post-article-inner">
            {{!-- Feature image at top --}}
            {{#if feature_image}}
            <figure class="post-feature-image">
                <img
                    src="{{feature_image}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                >
                {{#if feature_image_caption}}
                <figcaption class="text-center text-sm text-secondary mt-4">
                    {{feature_image_caption}}
                </figcaption>
                {{/if}}
            </figure>
            {{/if}}

            {{!-- Post header (title, meta) --}}
            <header class="post-header">
                <h1 class="post-title">{{title}}</h1>

                <div class="post-meta-header">
                    {{#primary_author}}
                    <div class="post-meta-author">
                        {{#if profile_image}}
                        <img
                            src="{{img_url profile_image size="xs"}}"
                            alt="{{name}}"
                            class="author-avatar rounded-full"
                            loading="lazy"
                        >
                        {{/if}}
                        <a href="{{url}}" class="author-name">{{name}}</a>
                    </div>
                    {{/primary_author}}

                    <div class="post-meta-info">
                        <span class="meta-item">
                            {{> "icons/calendar"}}
                            <time datetime="{{date format="YYYY-MM-DD"}}">
                                {{date format="MMM DD, YYYY"}}
                            </time>
                        </span>

                        {{#if reading_time}}
                        <span class="meta-item">
                            {{> "icons/clock"}}
                            {{reading_time}}
                        </span>
                        {{/if}}
                    </div>
                </div>
            </header>

            {{!-- Table of Contents (if enabled in settings) --}}
            {{#if @custom.show_toc}}
            <aside class="table-of-contents">
                <h3 class="toc-title">Table of Contents</h3>
                {{!-- TOC will be generated by JavaScript --}}
            </aside>
            {{/if}}

            {{!-- Post content --}}
            <div class="post-content my-12">
                {{{content}}}
            </div>

            {{!-- Series Navigation --}}
            {{> "series-nav"}}

            {{!-- Share Buttons --}}
            {{> "share-buttons"}}

            {{!-- Post footer --}}
            <footer class="post-footer mt-12 pt-4 border-t">
                {{!-- Tags --}}
                {{#if tags}}
                <div class="post-tags mb-8">
                    <h3 class="text-sm font-semibold mb-4 text-secondary">Tagged in:</h3>
                    <div class="flex flex-wrap gap-4">
                        {{#foreach tags}}<a href="{{url}}" class="tag">{{name}}</a>{{/foreach}}
                    </div>
                </div>
                {{/if}}

                {{!-- Author box --}}
                {{#primary_author}}
                <div class="author-box">
                    {{#if profile_image}}
                    <img
                        src="{{img_url profile_image size="s"}}"
                        alt="{{name}}"
                        class="author-avatar"
                        loading="lazy"
                    >
                    {{/if}}
                    <div class="author-info">
                        <h3 class="author-name">
                            <a href="{{url}}">{{name}}</a>
                        </h3>
                        {{#if bio}}
                        <p class="author-bio">{{bio}}</p>
                        {{/if}}
                        <div class="author-social-links">
                            {{#if website}}
                            <a href="{{website}}" class="author-social-link" target="_blank" rel="noopener" title="Website">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="2" y1="12" x2="22" y2="12"></line>
                                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                                </svg>
                            </a>
                            {{/if}}
                            {{#if twitter}}
                            <a href="{{twitter}}" class="author-social-link" target="_blank" rel="noopener" title="X">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                                </svg>
                            </a>
                            {{/if}}
                            {{#if facebook}}
                            <a href="{{facebook}}" class="author-social-link" target="_blank" rel="noopener" title="Facebook">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                </svg>
                            </a>
                            {{/if}}
                            {{#if linkedin}}
                            <a href="{{linkedin}}" class="author-social-link" target="_blank" rel="noopener" title="LinkedIn">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                </svg>
                            </a>
                            {{/if}}
                            {{#if bluesky}}
                            <a href="https://bsky.app/profile/{{bluesky}}" class="author-social-link" target="_blank" rel="noopener" title="Bluesky">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"/>
                                </svg>
                            </a>
                            {{/if}}
                            {{#if threads}}
                            <a href="{{threads}}" class="author-social-link" target="_blank" rel="noopener" title="Threads">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.96-.065-1.182.408-2.256 1.33-3.022.88-.73 2.082-1.168 3.59-1.304 1.297-.117 2.61-.009 3.907.139-.034-.87-.173-1.577-.42-2.107-.305-.656-.822-1.168-1.536-1.523-.782-.39-1.824-.594-3.096-.607l-.034-2.119c1.584.017 2.91.298 3.94.837 1.048.549 1.843 1.336 2.363 2.343.47.91.726 1.972.788 3.145.938.217 1.786.509 2.507.924 1.093.627 1.946 1.512 2.47 2.561.682 1.366.833 3.36-.299 5.063-1.238 1.86-3.235 2.972-5.942 3.303-.457.056-.937.084-1.437.084zm-.07-8.769c-.94.084-1.715.366-2.241.816-.49.418-.718.918-.682 1.49.034.54.307 1.013.793 1.372.533.394 1.292.592 2.136.556 1.098-.059 1.924-.452 2.456-1.167.392-.528.675-1.203.843-2.012-1.058-.148-2.168-.195-3.305-.055z"/>
                                </svg>
                            </a>
                            {{/if}}
                            {{#if mastodon}}
                            <a href="{{mastodon}}" class="author-social-link" target="_blank" rel="noopener" title="Mastodon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.668 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z"/>
                                </svg>
                            </a>
                            {{/if}}
                            {{#if tiktok}}
                            <a href="{{tiktok}}" class="author-social-link" target="_blank" rel="noopener" title="TikTok">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                                </svg>
                            </a>
                            {{/if}}
                            {{#if youtube}}
                            <a href="https://www.youtube.com/{{youtube}}" class="author-social-link" target="_blank" rel="noopener" title="YouTube">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                                </svg>
                            </a>
                            {{/if}}
                            {{#if instagram}}
                            <a href="{{instagram}}" class="author-social-link" target="_blank" rel="noopener" title="Instagram">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"/>
                                </svg>
                            </a>
                            {{/if}}
                        </div>
                    </div>
                </div>
                {{/primary_author}}
            </footer>

            {{!-- Related Posts --}}
            {{#get "posts" filter="tag:{{primary_tag.slug}}+id:-{{id}}" limit="3"}}
                {{#if posts}}
                <div class="related-posts">
                    <h2 class="related-posts-title text-center mb-8">Related Posts</h2>
                    <div class="related-posts-grid">
                        {{#foreach posts}}
                        <article class="related-post-card">
                            {{#if feature_image}}
                            <a href="{{url}}" class="related-post-image-link">
                                <img src="{{img_url feature_image size="s"}}" alt="{{title}}" class="related-post-image">
                            </a>
                            {{/if}}
                            <div class="related-post-content">
                                <h3 class="related-post-title">
                                    <a href="{{url}}">{{title}}</a>
                                </h3>
                                <p class="related-post-excerpt">{{excerpt words="15"}}</p>
                            </div>
                        </article>
                        {{/foreach}}
                    </div>
                </div>
                {{/if}}
            {{/get}}

            {{!-- Prev/Next Navigation --}}
            <nav class="post-nav">
                {{#prev_post}}
                <a href="{{url}}" class="post-nav-prev">
                    {{#if twitter_image}}
                    <img src="{{img_url twitter_image size="s"}}" alt="{{title}}" class="post-nav-image" loading="lazy">
                    {{else}}{{#if og_image}}
                    <img src="{{img_url og_image size="s"}}" alt="{{title}}" class="post-nav-image" loading="lazy">
                    {{else}}{{#if feature_image}}
                    <img src="{{img_url feature_image size="s"}}" alt="{{title}}" class="post-nav-image" loading="lazy">
                    {{/if}}{{/if}}{{/if}}
                    <div class="post-nav-content">
                        <span class="post-nav-label">Previous Post</span>
                        <span class="post-nav-title">{{title}}</span>
                    </div>
                </a>
                {{/prev_post}}

                {{#next_post}}
                <a href="{{url}}" class="post-nav-next">
                    {{#if twitter_image}}
                    <img src="{{img_url twitter_image size="s"}}" alt="{{title}}" class="post-nav-image" loading="lazy">
                    {{else}}{{#if og_image}}
                    <img src="{{img_url og_image size="s"}}" alt="{{title}}" class="post-nav-image" loading="lazy">
                    {{else}}{{#if feature_image}}
                    <img src="{{img_url feature_image size="s"}}" alt="{{title}}" class="post-nav-image" loading="lazy">
                    {{/if}}{{/if}}{{/if}}
                    <div class="post-nav-content">
                        <span class="post-nav-label">Next Post</span>
                        <span class="post-nav-title">{{title}}</span>
                    </div>
                </a>
                {{/next_post}}
            </nav>

            {{!-- Ghost Native Comments --}}
            {{#if comments}}
            <section class="post-comments my-16">
                {{comments}}
            </section>
            {{/if}}
        </div>
    </article>

    {{!-- Sidebar --}}
    {{> "sidebar"}}
</div>
{{/post}}
